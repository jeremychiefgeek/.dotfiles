" --------- Query replace (Emacs style) ----------------------------------------
" FIX: removed the earlier duplicate <M-%> mappings; this definition wins
function! QueryReplace(visual)
  let l:search  = input("Query replace: ")
  if l:search == "" | return | endif
  let l:replace = input("Replace with: ")
  if a:visual
    execute "'<,'>s/" . escape(l:search, '/') . "/" . escape(l:replace, '/') . "/gc"
  else
    execute "%s/" . escape(l:search, '/') . "/" . escape(l:replace, '/') . "/gc"
  endif
endfunction

nnoremap <leader>fr :call QueryReplace(0)<CR>
vnoremap <leader>fr :<C-u>call QueryReplace(1)<CR>
