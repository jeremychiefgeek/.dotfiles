{
  "layer": "top",

  "modules-left": ["custom/launcher", "cpu", "memory", "custom/media", "tray"],
  "modules-center": ["custom/workspaces"],
  "modules-right": ["custom/updates", "network", "pulseaudio", "clock", "battery", "custom/power"],

  "pulseaudio": {
    "tooltip": false,
    "scroll-step": 5,
    "format": "{icon} {volume}%",
    "format-muted": " muted",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "format-icons": {
      "default": ["", "", ""]
    }
  },

  "network": {
    "tooltip": false,
    "format-wifi": "  {essid}",
    "format-ethernet": "󰈀  {ifname}",
    "format-disconnected": "󰖪  offline"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 20
    },
    "format": "{icon}  {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["", "", "", "", ""]
  },

  "custom/workspaces": {
    "exec": "~/.config/waybar/scripts/hypr-ws.sh",
    "return-type": "json",
    "interval": 1,
    "format": "{}",
    "markup": true,
    "tooltip": true
  },

  "clock": {
    "interval": 60,
    "format": "  {0:%I:%M %p}    {0:%m/%d/%Y}",
    "tooltip-format": "{0:%A, %B %d, %Y}"
  },

  "cpu": {
    "interval": 15,
    "format": " {}%",
    "max-length": 10
  },

  "memory": {
    "interval": 30,
    "format": " {}%",
    "max-length": 10
  },

  "custom/media": {
    "interval": 2,
    "format": "{icon} {}",
    "return-type": "json",
    "max-length": 20,
    "format-icons": {
      "spotify": "",
      "default": ""
    },
    "escape": true,
    "exec": "$HOME/.config/system_scripts/mediaplayer.py 2> /dev/null",
    "on-click": "playerctl play-pause"
  },

  "custom/launcher": {
    "format": "",
    "on-click": "rofi -show drun",
    "on-click-right": "killall rofi"
  },

  "custom/power": {
    "format": "",
    "on-click": "bash ~/.config/rofi/leave/leave.sh"
  },

  "custom/updates": {
    "format": "󰏔 {}",
    "exec": "checkupdates | wc -l",
    "exec-if": "test \"$(checkupdates | wc -l)\" -ne 0",
    "interval": 600,
    "on-click": "kitty --hold yay -Syu && notify-send 'The system has been updated'"
  }
}

